{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pipandflicker",
  "compatibility_date": "2026-10-23",
  "routes": [
    { "pattern": "pipandflicker.adrianburcin.com", "custom_domain": true },
    { "pattern": "pipandflicker.zmeustudio.com", "custom_domain": true }
  ],
  "main": "worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/media/*"]
  }
}
